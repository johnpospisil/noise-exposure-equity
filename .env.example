# Copy to .env and fill in. Never commit .env.
# Free key: https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=
# Optional, free, raises Socrata rate limits: https://data.cityofnewyork.us/profile/edit/developer_settings
SOCRATA_APP_TOKEN=
# Optional: put data somewhere other than ./data
# NE_DATA_DIR=
